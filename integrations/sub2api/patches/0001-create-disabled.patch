+//go:build unit
+
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// JSON keeps this regression test executable against the pre-feature baseline.
+func createDisabledTestInput(t *testing.T, disabled bool) *CreateAccountInput {
+	t.Helper()
+	input := &CreateAccountInput{
+		Name: "inert-gemini-sa", Platform: PlatformGemini, Type: AccountTypeServiceAccount,
+		Credentials: map[string]any{"project_id": "unit-test-only"}, GroupIDs: []int64{7},
+	}
+	if disabled {
+		require.NoError(t, json.Unmarshal([]byte(`{"CreateDisabled":true}`), input))
+	}
+	return input
+}
+
+func TestBuildAccountForCreateDisabled(t *testing.T) {
+	for _, disabled := range []bool{false, true} {
+		name, status := "default", StatusActive
+		if disabled {
+			name, status = "disabled", "inactive"
+		}
+		t.Run(name, func(t *testing.T) {
+			account, err := buildAccountForCreate(createDisabledTestInput(t, disabled), nil)
+			require.NoError(t, err)
+			require.Equal(t, status, account.Status)
+			require.Equal(t, !disabled, account.Schedulable)
+			require.Equal(t, !disabled, account.IsSchedulable())
+		})
+	}
+}
+
+type createDisabledRepoStub struct {
+	accountRepoStubForBulkUpdate
+	firstWrite  Account
+	createCalls int
+}
+
+func (s *createDisabledRepoStub) Create(ctx context.Context, account *Account) error {
+	// Snapshot values at the persistence boundary, not a pointer later updates can change.
+	s.firstWrite = *account
+	s.createCalls++
+	return s.accountRepoStubForBulkUpdate.Create(ctx, account)
+}
+
+func TestCreateAccountDisabledAtFirstWrite(t *testing.T) {
+	bindErr := errors.New("group binding failed")
+	for _, tc := range []struct {
+		name     string
+		disabled bool
+		bindErr  error
+	}{
+		{name: "default"},
+		{name: "disabled", disabled: true},
+		{name: "binding_failure_stays_disabled", disabled: true, bindErr: bindErr},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &createDisabledRepoStub{accountRepoStubForBulkUpdate: accountRepoStubForBulkUpdate{
+				createID: 99, bindGroupErrByID: map[int64]error{99: tc.bindErr},
+			}}
+			svc := &adminServiceImpl{accountRepo: repo}
+			account, err := svc.CreateAccount(context.Background(), createDisabledTestInput(t, tc.disabled))
+			if tc.bindErr != nil {
+				require.ErrorIs(t, err, tc.bindErr)
+				require.Nil(t, account)
+			} else {
+				require.NoError(t, err)
+				require.Equal(t, !tc.disabled, account.IsSchedulable())
+			}
+			status := StatusActive
+			if tc.disabled {
+				status = "inactive"
+			}
+			require.Equal(t, 1, repo.createCalls)
+			require.Equal(t, status, repo.firstWrite.Status)
+			require.Equal(t, !tc.disabled, repo.firstWrite.Schedulable)
+			require.Equal(t, !tc.disabled, repo.firstWrite.IsSchedulable())
+			require.Equal(t, status, repo.createAccount.Status)
+			require.Equal(t, !tc.disabled, repo.createAccount.Schedulable)
+			require.Empty(t, repo.updatedAccounts, "must not create active and then disable with Update")
+			require.Zero(t, repo.bulkUpdateCalls)
+			require.Equal(t, []int64{99}, repo.bindGroupsCalls)
+			require.Equal(t, []int64{7}, repo.bindGroupsByAccount[99])
+		})
+	}
+}
+
+func TestCreateAccountDisabledPreservesValidation(t *testing.T) {
+	input := createDisabledTestInput(t, true)
+	negative := -1.0
+	input.RateMultiplier = &negative
+	repo := &createDisabledRepoStub{}
+	account, err := (&adminServiceImpl{accountRepo: repo}).CreateAccount(context.Background(), input)
+	require.ErrorContains(t, err, "rate_multiplier must be >= 0")
+	require.Nil(t, account)
+	require.Zero(t, repo.createCalls)
+}
