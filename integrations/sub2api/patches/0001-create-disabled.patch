+//go:build unit
+
+package admin
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+const createDisabledBaseJSON = `{"name":"inert-sa","platform":"gemini","type":"service_account","credentials":{"project_id":"unit-test-only"},"group_ids":[7]}`
+
+func createDisabledRequestJSON(flag string) string {
+	if flag == "" {
+		return createDisabledBaseJSON
+	}
+	return strings.TrimSuffix(createDisabledBaseJSON, "}") + `,"create_disabled":` + flag + `}`
+}
+
+func TestCreateAccountRequestDisabledJSONCompatibility(t *testing.T) {
+	// Exact pre-feature encoding: omitted/false must not change existing idempotency payload hashes.
+	const legacy = `{"name":"inert-sa","notes":null,"platform":"gemini","type":"service_account","credentials":{"project_id":"unit-test-only"},"extra":null,"proxy_id":null,"concurrency":0,"priority":0,"rate_multiplier":null,"load_factor":null,"group_ids":[7],"expires_at":null,"auto_pause_on_expired":null,"upstream_billing_probe_enabled":null,"confirm_mixed_channel_risk":null}`
+	for _, flag := range []string{"", "false", "true"} {
+		t.Run("flag_"+flag, func(t *testing.T) {
+			var req CreateAccountRequest
+			require.NoError(t, json.Unmarshal([]byte(createDisabledRequestJSON(flag)), &req))
+			encoded, err := json.Marshal(req)
+			require.NoError(t, err)
+			if flag == "true" {
+				require.Contains(t, string(encoded), `"create_disabled":true`)
+				require.NotEqual(t, sha256.Sum256([]byte(legacy)), sha256.Sum256(encoded))
+			} else {
+				require.Equal(t, legacy, string(encoded))
+				require.Equal(t, sha256.Sum256([]byte(legacy)), sha256.Sum256(encoded))
+			}
+		})
+	}
+}
+
+type createDisabledAdminStub struct{ *stubAdminService }
+
+func (s *createDisabledAdminStub) CreateAccount(ctx context.Context, input *service.CreateAccountInput) (*service.Account, error) {
+	account, err := s.stubAdminService.CreateAccount(ctx, input)
+	if account != nil {
+		account.Platform, account.Type = input.Platform, input.Type
+	}
+	return account, err
+}
+
+func assertCreateDisabledInput(t *testing.T, input *service.CreateAccountInput, want bool) {
+	t.Helper()
+	encoded, err := json.Marshal(input)
+	require.NoError(t, err)
+	var fields map[string]any
+	require.NoError(t, json.Unmarshal(encoded, &fields))
+	got, _ := fields["CreateDisabled"].(bool)
+	require.Equal(t, want, got)
+	require.Equal(t, service.PlatformGemini, input.Platform)
+	require.Equal(t, service.AccountTypeServiceAccount, input.Type)
+	require.Equal(t, []int64{7}, input.GroupIDs)
+}
+
+func TestAccountHandlerCreateDisabledPropagation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, flag := range []string{"", "false", "true"} {
+		t.Run("flag_"+flag, func(t *testing.T) {
+			svc := &createDisabledAdminStub{newStubAdminService()}
+			h := NewAccountHandler(svc, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+			r := gin.New()
+			r.POST("/accounts", h.Create)
+			res := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodPost, "/accounts", strings.NewReader(createDisabledRequestJSON(flag)))
+			req.Header.Set("Content-Type", "application/json")
+			r.ServeHTTP(res, req)
+			require.Equal(t, http.StatusOK, res.Code, res.Body.String())
+			require.Len(t, svc.createdAccounts, 1)
+			assertCreateDisabledInput(t, svc.createdAccounts[0], flag == "true")
+		})
+	}
+}
+
+func TestAccountHandlerBatchCreateDisabledPropagation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	svc := &createDisabledAdminStub{newStubAdminService()}
+	h := NewAccountHandler(svc, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+	r := gin.New()
+	r.POST("/accounts/batch", h.BatchCreate)
+	body := `{"accounts":[` + createDisabledRequestJSON("true") + "," + createDisabledRequestJSON("") + "," + createDisabledRequestJSON("false") + `]}`
+	res := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/accounts/batch", strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(res, req)
+	require.Equal(t, http.StatusOK, res.Code, res.Body.String())
+	require.Len(t, svc.createdAccounts, 3)
+	for i, want := range []bool{true, false, false} {
+		assertCreateDisabledInput(t, svc.createdAccounts[i], want)
+	}
+}
+
+func TestAccountHandlerCreateDisabledRejectsInvalidType(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	svc := &createDisabledAdminStub{newStubAdminService()}
+	h := NewAccountHandler(svc, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+	r := gin.New()
+	r.POST("/accounts", h.Create)
+	res := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/accounts", strings.NewReader(createDisabledRequestJSON(`"true"`)))
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(res, req)
+	require.Equal(t, http.StatusBadRequest, res.Code, res.Body.String())
+	require.Empty(t, svc.createdAccounts)
+}
